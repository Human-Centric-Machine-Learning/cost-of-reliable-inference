# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/
build/
dist/
*.egg-info/

# Run directories written by cri.experiment.run_experiment
outputs/

scripts/
tests/

# Generated inputs, too large to commit; rebuild with build_datasets.py and build_rewards.py
datasets/
rewards/

# Built page assets (web/build.py): packed copies of the recorded generations plus a
# precomputed run, about 6 MB. Commit them only when publishing the page.
web/app/data/

# The GitHub Pages workflow; keep it out until the page should go live
.github/

# Paper material: LaTeX sources and macros, the paper's PDF and design notes
*.tex
*.sty
*.pdf
reading_guide.txt
DESIGN.md
paper/
iclr2027/

# analysis/: only the executed notebooks of the paper's experiments are committed;
# their figures and tables (analysis/results/) are rebuilt by running them
analysis/*
!analysis/GSM8K-full.ipynb
!analysis/GSM8K-ladder.ipynb
!analysis/GPQA-full.ipynb
!analysis/GPQA-ladder.ipynb
!analysis/GPQA-strong.ipynb

